# =========================
# TruthLens Master .gitignore
# =========================

# Python & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Secrets & Keys (CRITICAL)
.env
*.local
*.pem
*.key

# AI Models & Large Binaries
*.safetensors
*.ckpt
*.pt
*.bin
*.tar.gz

# Local TruthLens Database & Indices
truthlens/backend/data/*.pkl
truthlens/backend/data/faiss.index
*.sqlite3

# Frontend / Node
node_modules/
npm-debug.log*

# Testing & Logs
.pytest_cache/
*.log

# OS & IDE
.DS_Store
.vscode/
.idea/
